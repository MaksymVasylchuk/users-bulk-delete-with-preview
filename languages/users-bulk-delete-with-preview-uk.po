#. Plugin Name of the plugin
#: ubdwp-users-bulk-delete-with-preview.php
#: src/Services/UbdwpPrivacy.php:418
msgid "Users Bulk Delete With Preview"
msgstr "Масове видалення користувачів із попереднім переглядом"

#. Plugin URI of the plugin
#: ubdwp-users-bulk-delete-with-preview.php
msgid "https://github.com/MaksymVasylchuk/users-bulk-delete-with-preview"
msgstr "https://github.com/MaksymVasylchuk/users-bulk-delete-with-preview"

#. Description of the plugin
#: ubdwp-users-bulk-delete-with-preview.php
msgid "Effortlessly delete multiple WordPress users with our Users Bulk Delete With Preview plugin. View and confirm user details before removal to ensure accuracy and avoid mistakes. Streamline your user management process with ease and confidence!"
msgstr "Легко видаляйте багатьох користувачів WordPress за допомогою плагіна Users Bulk Delete With Preview. Переглядайте й підтверджуйте дані користувачів перед видаленням, щоб уникнути помилок. Керуйте користувачами просто й упевнено!"

#. Author of the plugin
#: ubdwp-users-bulk-delete-with-preview.php
msgid "maksymvasylchuk"
msgstr "maksymvasylchuk"

#. Author URI of the plugin
#: ubdwp-users-bulk-delete-with-preview.php
